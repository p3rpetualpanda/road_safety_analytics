table ras0201_rates
	lineageTag: 46c96dbc-17c2-426b-a367-0267101b56cb

	measure 'DfT Published KSI Rate' =
			CALCULATE (
			    MAX ( ras0201_rates[rate_value] ),
			    ras0201_rates[year] = MAX ( dim_date[year] ),
			    ras0201_rates[road_user_type] = "All road users",
			    ras0201_rates[severity] = "KSI (adjusted)"
			)
			
			// DfT published fatal rate (per billion vehicle miles)
		lineageTag: e96710e0-b8ae-42dd-86df-18734aef55b6

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'DfT Published Fatal Rate' =
			CALCULATE (
			    MAX ( ras0201_rates[rate_value] ),
			    ras0201_rates[year] = MAX ( dim_date[year] ),
			    ras0201_rates[road_user_type] = "All road users",
			    ras0201_rates[severity] = "Killed"
			)
		lineageTag: 6d682ef8-ca50-4e0a-9cce-23b6aec2e289

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column year
		dataType: int64
		formatString: 0
