table fact_vehicle
	lineageTag: 82cface9-4664-4338-8d08-a96d4753cca2

	measure 'Vehicles Involved' =
			COUNTROWS ( fact_vehicle )
			
			// Serious/fatal ACCIDENTS (for the weather & lighting visuals).
			// Weather and lighting are recorded per accident, so counting the accidents
			// that were serious/fatal is the correct semantics. COUNTROWS(fact_casualty)
			// would NOT respond to these filters because they live in fact_accident.
		lineageTag: f46c0920-dea4-48f5-838c-b2f8433f2620

	measure 'Vehicle Serious Fatal Share' =
			
			DIVIDE (
			    CALCULATE ( [Vehicles Involved], fact_accident[severity] IN { 1, 2 } ),
			    [Vehicles Involved]
			)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: fd12ee28-ee8a-45d3-886d-955cdaf44f8f

	column vehicle_rec
		dataType: string
		lineageTag: 4bf6ac66-3ab9-456c-b2a3-7c7b1f09188a
		summarizeBy: none
		sourceColumn: vehicle_rec

		annotation SummarizationSetBy = Automatic

