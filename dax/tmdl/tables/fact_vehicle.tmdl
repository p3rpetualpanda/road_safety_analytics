				let
				  Source = PostgreSQL.Database("localhost", "road_safety"),
				  #"Navigation 1" = Source{[Schema = "public", Item = "fact_vehicle"]}[Data]
				in
				  #"Navigation 1"

	changedProperty = Name

	annotation PBI_ResultType = Table

