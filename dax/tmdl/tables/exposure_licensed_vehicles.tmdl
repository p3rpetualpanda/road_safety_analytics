table exposure_licensed_vehicles
	lineageTag: f36b056d-82b0-4788-ad68-7ddf42be2fea

	measure 'SF Per 100K Vehicles' =
			VAR SF = [Serious Fatal Casualties]
			VAR VEH =
			    CALCULATE (
			        SUM ( exposure_licensed_vehicles[vehicles_thousand] ),
			        TREATAS ( VALUES ( dim_date[year] ), exposure_licensed_vehicles[year] ),
			        exposure_licensed_vehicles[geo_name] = "Great Britain",
			        exposure_licensed_vehicles[vehicle_type] = "Total"
			    )
			RETURN
			    DIVIDE ( SF * 100000, VEH * 1000, 0 )
			
			// ------------------------------------------------------------
			// DfT published KSI rate (per billion vehicle miles)
			// From RAS0201 Rates sheet — DfT's own published casualty rates.
			// Use for validation against our calculated rates.
			// Note: DfT uses MILES, not km. 1 mile = 1.609344 km.
			// ------------------------------------------------------------
		lineageTag: 5c679623-61e6-410d-82e0-da79fdff91c3

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column year
		dataType: int64
		formatString: 0
		lineageTag: 7af5d03e-3450-4977-ab15-e24c057e622d
		summarizeBy: none
		sourceColumn: year

